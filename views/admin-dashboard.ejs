<%- include('partials/head') %><%- include('partials/nav') %><section class="section wrap admin-area"><div class="admin-top"><div><div class="eyebrow">CONTENT MANAGEMENT</div><h1>Admin <em>dashboard.</em></h1><p>Signed in as <strong><%= user.email %></strong></p></div><form action="/admin/logout" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-outline" type="submit">Sign out</button></form></div>
<div class="admin-stats"><div><small>PACKAGE TEMPLATES</small><strong><%= stats.packages %></strong><a href="/admin/packages/new">Add a package ↗</a></div><div><small>DESTINATIONS</small><strong><%= stats.destinations %></strong><a href="/admin/destinations/new">Add destination ↗</a></div><div><small>NEW ENQUIRIES</small><strong><%= stats.enquiries %></strong><a href="/admin/enquiries.csv">Export CSV ↗</a></div></div>
<div class="admin-section-head"><h2>Recent packages</h2><a class="btn btn-primary" href="/admin/packages/new">+ New package</a></div><div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>Package</th><th>Destination</th><th>Status</th><th>Price</th><th></th></tr></thead><tbody><% packages.forEach(p=>{ %><tr><td><strong><%= p.title %></strong><small>/<%= p.slug %></small></td><td><%= p.destination %></td><td><span class="status status-<%= p.status %>"><%= p.status %></span></td><td><%= p.price?'₹'+p.price:'Quote' %></td><td><a class="table-link" href="/admin/packages/<%= p.id %>/edit">Edit ↗</a></td></tr><% }) %></tbody></table></div>
<div class="admin-section-head"><h2>Recent enquiries</h2><a class="text-link" href="/admin/enquiries.csv">Download CSV ↗</a></div><div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>Traveller</th><th>Trip interest</th><th>Contact</th><th>Received</th><th>Status</th></tr></thead><tbody><% if(enquiries.length){ enquiries.forEach(e=>{ %><tr><td><strong><%= e.name %></strong><small><%= e.email %></small></td><td><%= e.destination||'Custom trip' %><small><%= e.message %></small></td><td><a href="tel:<%= e.phone %>"><%= e.phone %></a></td><td><%= e.created_at %></td><td><form class="status-form" action="/admin/enquiries/<%= e.id %>/status" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><select name="status" onchange="this.form.submit()"><% ['New','Contacted','Quoted','Closed'].forEach(s=>{ %><option <%= e.status===s?'selected':'' %>><%= s %></option><% }) %></select></form></td></tr><% }) }else{ %><tr><td colspan="5">No enquiries yet. New enquiries will appear here.</td></tr><% } %></tbody></table></div>
<div class="admin-section-head"><h2>Destination management</h2><a class="btn btn-outline" href="/admin/destinations/new">+ Add destination</a></div><div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>Destination</th><th>Region</th><th>Status</th><th></th></tr></thead><tbody><% destinations.forEach(d=>{ %><tr><td><strong><%= d.name %></strong><small>/<%= d.slug %></small></td><td><%= d.region %></td><td><span class="status status-<%= d.status %>"><%= d.status %></span></td><td><a class="table-link" href="/admin/destinations/<%= d.id %>/edit">Edit ↗</a></td></tr><% }) %></tbody></table></div><div class="admin-destination-note"><p>Published destinations are visible on the public website. Archive a destination instead of deleting it to preserve linked package references.</p><a href="/destinations" target="_blank" rel="noopener">View public destinations ↗</a></div>
</section><%- include('partials/footer') %>
