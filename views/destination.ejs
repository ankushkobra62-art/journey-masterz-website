<%- include('partials/head') %><%- include('partials/nav') %>
<section class="destination-hero" style="--detail-image:url('<%= destination.image %>')"><div class="wrap detail-hero-content"><div class="breadcrumbs"><a href="/">Home</a> / <a href="/destinations">Destinations</a> / <%= destination.name %></div><div class="eyebrow light-eyebrow"><%= destination.region %></div><h1>Discover <em><%= destination.name %>.</em></h1><p><%= destination.summary %></p><a class="btn btn-primary" href="/custom-trip">Plan a trip here ↗</a></div></section>
<section class="section wrap"><div class="destination-overview"><div><div class="eyebrow">A PLACE TO BEGIN</div><h2>Make room for <em>discovery.</em></h2><p><%= destination.summary %></p><p><strong>Popular places:</strong> <%= destination.highlights %></p><p>Travel seasons, access, route conditions and activity availability can vary. Ask us to confirm details for your intended dates.</p></div><div class="overview-image"><img src="<%= destination.image %>" alt="Travel scenery in <%= destination.name %>" loading="lazy"></div></div></section>
<section class="section section-soft"><div class="wrap"><div class="section-heading"><div><div class="eyebrow">TRIP IDEAS IN THIS REGION</div><h2>Explore <em><%= destination.name %>.</em></h2></div><a class="text-link" href="/packages">All packages ↗</a></div><% if(packages.length){ %><div class="package-grid"><% packages.forEach(p=>{ %><%- include('partials/package-card',{p}) %><% }) %></div><% }else{ %><div class="empty-state"><h3>Let's build a trip for this region.</h3><p>Tell us what you'd like to see and we'll help shape a plan.</p><a class="btn btn-primary" href="/custom-trip">Request a custom quote ↗</a></div><% } %></div></section>
<%- include('partials/footer') %>
