<%- include('partials/head') %><%- include('partials/nav') %>
<section class="detail-hero" style="--detail-image:url('<%= package.image %>')"><div class="wrap detail-hero-content"><div class="breadcrumbs"><a href="/">Home</a> / <a href="/packages">Packages</a> / <%= package.title %></div><span class="pill"><%= package.category %></span><h1><%= package.title %></h1><p><%= package.destination %> · <%= package.region %></p></div></section>
<section class="section wrap detail-layout"><article class="detail-main"><div class="detail-meta"><div><small>TRIP DURATION</small><strong><%= package.duration %></strong></div><div><small>BEST TIME</small><strong><%= package.season %></strong></div><div><small>TRIP STYLE</small><strong><%= package.category %></strong></div></div><h2>About this <em>journey.</em></h2><p><%= package.summary %></p><div class="notice"><strong>Planning note</strong><p>This package is a flexible sample template. Route, hotel, transport, opening dates and availability are confirmed after enquiry. No access, registration or darshan is guaranteed.</p></div><h2>Suggested <em>itinerary.</em></h2><div class="itinerary"><% (package.itinerary||'Itinerary to be confirmed').split('\\n').forEach((line,i)=>{if(line.trim()){ %><div class="itinerary-line"><span><%= String(i+1).padStart(2,'0') %></span><p><%= line %></p></div><% }}) %></div><div class="two-col-info"><div><h3>What's included</h3><p><%= package.inclusions||'To be confirmed in your written quote.' %></p></div><div><h3>Not included</h3><p><%= package.exclusions||'To be confirmed in your written quote.' %></p></div></div><h2>Make it <em>your own.</em></h2><p>Want to change the pace, add a stop or travel from another city? Tell us what works for you.</p><a class="btn btn-outline" href="/custom-trip">Customise this trip ↗</a></article>
<aside class="detail-aside"><div class="quote-card"><small>YOUR TRIP ESTIMATE</small><div class="quote-price"><%= package.price ? '₹'+package.price : 'Request a Quote' %></div><p>Get a quote based on your dates, group size and selected services.</p><%- include('partials/enquiry-form',{destination:package.title}) %></div><div class="contact-mini"><strong>Prefer to talk?</strong><a href="tel:+919899266481">+91 9899266481</a><a href="https://wa.me/919899266481" target="_blank" rel="noopener">Message us on WhatsApp ↗</a></div></aside></section>
<% if(similar.length){ %><section class="section section-soft"><div class="wrap"><div class="section-heading"><div><div class="eyebrow">MORE WAYS TO EXPLORE</div><h2>You might also <em>love.</em></h2></div><a class="text-link" href="/packages">All packages ↗</a></div><div class="package-grid"><% similar.forEach(p=>{ %><%- include('partials/package-card',{p}) %><% }) %></div></div></section><% } %>
<%- include('partials/footer') %>
