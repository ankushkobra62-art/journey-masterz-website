<%- include('partials/head') %><%- include('partials/nav') %><section class="section wrap admin-area"><div class="admin-top"><div><div class="eyebrow">CONTENT MANAGEMENT</div><h1><%= item && item.id?'Edit':'Add' %> destination.</h1><p>Destinations are editable without changing application code.</p></div><a class="btn btn-outline" href="/admin">← Dashboard</a></div><% if(error){ %><div class="alert"><%= error %></div><% } %><form class="admin-edit-form" action="/admin/destinations/save" method="post" enctype="multipart/form-data"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="id" value="<%= item?.id||'' %>"><div class="admin-form-grid"><label>Name *<input name="name" required value="<%= item?.name||'' %>"></label><label>URL slug<input name="slug" value="<%= item?.slug||'' %>"></label><label>Region<input name="region" value="<%= item?.region||'' %>"></label><label>Status<select name="status"><% ['published','draft','archived'].forEach(s=>{ %><option value="<%= s %>" <%= (item?.status||'published')===s?'selected':'' %>><%= s %></option><% }) %></select></label><label class="full-field">Overview<textarea name="summary" rows="4"><%= item?.summary||'' %></textarea></label><label class="full-field">Popular places / highlights<textarea name="highlights" rows="3"><%= item?.highlights||'' %></textarea></label><label class="full-field">Image URL<input name="image" value="<%= item?.image||'' %>"></label><label class="full-field">Upload image (max 5 MB)<input type="file" name="imageFile" accept="image/jpeg,image/png,image/webp,image/gif"></label></div><div class="admin-form-actions"><button class="btn btn-primary" type="submit">Save destination ↗</button><a class="btn btn-outline" href="/admin">Cancel</a></div></form></section><%- include('partials/footer') %>
