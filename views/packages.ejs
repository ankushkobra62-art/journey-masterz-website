<%- include('partials/head') %><%- include('partials/nav') %>
<section class="page-hero"><div class="wrap"><div class="eyebrow light-eyebrow">FIND YOUR NEXT GETAWAY</div><h1>India holiday <em>packages.</em></h1><p>Explore our trip ideas, then ask us to tailor one to your travel style.</p><div class="breadcrumbs"><a href="/">Home</a> / Holiday packages</div></div></section>
<section class="section wrap"><form class="filters" action="/packages" method="get"><label>Search<input name="q" value="<%= q %>" placeholder="Destination or trip name"></label><label>Region<select name="region"><option value="">All regions</option><% regions.forEach(r=>{ %><option value="<%= r %>" <%= region===r?'selected':'' %>><%= r %></option><% }) %></select></label><label>Travel style<select name="category"><option value="">All styles</option><% categories.forEach(c=>{ %><option value="<%= c %>" <%= category===c?'selected':'' %>><%= c %></option><% }) %></select></label><button class="btn btn-primary" type="submit">Apply filters ↗</button><a class="clear-filter" href="/packages">Clear</a></form>
<div class="results-heading"><span><strong><%= total %></strong> trip ideas <%= q||region||category?' matching your filters':'' %></span><span>Prices shown only when confirmed</span></div>
<% if(packages.length){ %><div class="package-grid"><% packages.forEach(p=>{ %><%- include('partials/package-card',{p}) %><% }) %></div><% }else{ %><div class="empty-state"><span>⌕</span><h2>No trips found just yet</h2><p>Try a broader search or ask us to plan something from scratch.</p><a class="btn btn-primary" href="/custom-trip">Plan a custom trip ↗</a></div><% } %>
<% if(Math.ceil(total/limit)>1){ %><div class="pagination"><% if(page>1){ %><a href="?q=<%= encodeURIComponent(q) %>&region=<%= encodeURIComponent(region) %>&category=<%= encodeURIComponent(category) %>&page=<%= page-1 %>">← Previous</a><% } %><span>Page <%= page %> of <%= Math.ceil(total/limit) %></span><% if(page<Math.ceil(total/limit)){ %><a href="?q=<%= encodeURIComponent(q) %>&region=<%= encodeURIComponent(region) %>&category=<%= encodeURIComponent(category) %>&page=<%= page+1 %>">Next →</a><% } %></div><% } %>
</section><%- include('partials/footer') %>
