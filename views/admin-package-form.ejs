<%- include('partials/head') %><%- include('partials/nav') %><section class="section wrap admin-area"><div class="admin-top"><div><div class="eyebrow">CONTENT MANAGEMENT</div><h1><%= item && item.id?'Edit':'Add' %> package <em>template.</em></h1><p>Use a unique slug. Leave price empty until verified.</p></div><a class="btn btn-outline" href="/admin">← Dashboard</a></div><% if(error){ %><div class="alert"><%= error %></div><% } %>
<form class="admin-edit-form" action="/admin/packages/save" method="post" enctype="multipart/form-data"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="id" value="<%= item?.id||'' %>"><div class="admin-form-grid">
<label>Package title *<input name="title" required value="<%= item?.title||'' %>"></label><label>URL slug<input name="slug" value="<%= item?.slug||'' %>" placeholder="auto-from-title"></label>
<label>Destination *<input name="destination" required value="<%= item?.destination||'' %>" list="destination-list"><datalist id="destination-list"><% destinations.forEach(d=>{ %><option value="<%= d.name %>"><% }) %></datalist></label><label>Region<input name="region" value="<%= item?.region||'' %>" placeholder="North India, South India..."></label>
<label>Category<input name="category" value="<%= item?.category||'Domestic Holidays' %>"></label><label>Duration<input name="duration" value="<%= item?.duration||'Request a tailored duration' %>"></label><label>Suggested season<input name="season" value="<%= item?.season||'Confirm dates and season' %>"></label><label>Price (optional)<input name="price" value="<%= item?.price||'' %>" placeholder="Leave blank to show Request a Quote"></label>
<label class="full-field">Short description<textarea name="summary" rows="3"><%= item?.summary||'' %></textarea></label>
<label class="full-field">Day-by-day itinerary<textarea name="itinerary" rows="7"><%= item?.itinerary||'Day 1 — Arrival and check-in (to be confirmed)\nDay 2 — Local sightseeing or planned experiences\nDay 3 — Flexible exploration and return transfer' %></textarea></label>
<label>Inclusions<textarea name="inclusions" rows="3"><%= item?.inclusions||'' %></textarea></label><label>Exclusions<textarea name="exclusions" rows="3"><%= item?.exclusions||'' %></textarea></label>
<label class="full-field">Image URL (optional)<input name="image" value="<%= item?.image||'' %>" placeholder="https://..."></label><label class="full-field">Upload image (JPG, PNG, WEBP, GIF · max 5 MB)<input type="file" name="imageFile" accept="image/jpeg,image/png,image/webp,image/gif"></label>
<label>Status<select name="status"><% ['published','draft','archived'].forEach(s=>{ %><option value="<%= s %>" <%= (item?.status||'published')===s?'selected':'' %>><%= s %></option><% }) %></select></label><label class="check-label"><input type="checkbox" name="featured" <%= item?.featured?'checked':'' %>> Feature on homepage</label>
</div><div class="admin-form-actions"><button class="btn btn-primary" type="submit">Save package ↗</button><a class="btn btn-outline" href="/admin">Cancel</a></div></form></section><%- include('partials/footer') %>
